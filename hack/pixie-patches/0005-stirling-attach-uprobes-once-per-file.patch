+  const size_t num_probes = DeployGoUProbes({md::UPID(0, kPID1, 0)});
+  ASSERT_GT(num_probes, 0u);
+  EXPECT_THAT(bcc_.attached, SizeIs(num_probes));
+
+  EXPECT_EQ(DeployGoUProbes({md::UPID(0, kPID2, 0)}), 0);
+  EXPECT_THAT(bcc_.attached, SizeIs(num_probes));
+
+  EXPECT_TRUE(go_tls_symaddrs_map_->entries.contains(kPID1));
+  EXPECT_TRUE(go_tls_symaddrs_map_->entries.contains(kPID2));
+}
