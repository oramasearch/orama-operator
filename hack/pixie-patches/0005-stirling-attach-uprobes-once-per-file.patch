+// Runs UProbeManager against a fake /proc tree: each fake process has a maps file and a root/
+// directory whose files are symlinks to files under host/, so several processes can map one file.
+class UProbeManagerTest : public ::testing::Test {
+ protected:
+  // Fake PIDs, high enough not to collide with the test's own PID (see DeployGoUProbes).
+  static constexpr uint32_t kPID1 = 900001;
+  static constexpr uint32_t kPID2 = 900002;
+  static constexpr uint32_t kPID3 = 900003;
+  static constexpr size_t kNumOpenSSLProbes = 9;
+
+  static constexpr std::string_view kLibSSLPath = "/usr/lib/x86_64-linux-gnu/libssl.so.3";
+  static constexpr std::string_view kLibCryptoPath = "/usr/lib/x86_64-linux-gnu/libcrypto.so.3";
+  static constexpr std::string_view kGoTLSServer =
+      "src/stirling/testing/demo_apps/go_grpc_tls_pl/server/golang_1_24_grpc_tls_server_binary";
+
+  void SetUp() override {
+    FLAGS_proc_path = (temp_dir_.path() / "proc").string();
+
+    uprobe_mgr_.Init(/*disable_go_tls_tracing*/ false, /*enable_http2_tracing*/ false);
+
+    auto openssl_source_map = std::make_unique<InMemoryBCCMap<ssl_source_t>>();
+    openssl_source_map_ = openssl_source_map.get();
+    uprobe_mgr_.openssl_source_map_ = std::move(openssl_source_map);
+
+    auto go_tls_symaddrs_map = std::make_unique<InMemoryBCCMap<struct go_tls_symaddrs_t>>();
+    go_tls_symaddrs_map_ = go_tls_symaddrs_map.get();
+    uprobe_mgr_.go_tls_symaddrs_map_ = std::move(go_tls_symaddrs_map);
+  }
+
+  void TearDown() override { FLAGS_proc_path = original_proc_path_; }
+
+  // Creates a file under host/ and returns its path.
+  std::filesystem::path HostFile(std::string_view name) {
+    const std::filesystem::path path = temp_dir_.path() / "host" / name;
+    PX_CHECK_OK(fs::CreateDirectories(path.parent_path()));
+    PX_CHECK_OK(WriteFileFromString(path, "not really a library"));
+    return path;
+  }
+
+  // Makes path (absolute, inside the process's mount namespace) resolve to host_file.
+  void LinkInRoot(int pid, std::string_view path, const std::filesystem::path& host_file) {
+    const std::filesystem::path link = system::ProcPidRootPath(pid, path);
+    PX_CHECK_OK(fs::CreateDirectories(link.parent_path()));
+    PX_CHECK_OK(fs::CreateSymlink(host_file, link));
+  }
+
+  // A process that maps libssl.so.3 and libcrypto.so.3, resolving to the given host files.
+  void FakeOpenSSLProcess(int pid, const std::filesystem::path& host_libssl,
+                          const std::filesystem::path& host_libcrypto) {
+    PX_CHECK_OK(fs::CreateDirectories(system::ProcPidPath(pid)));
+    const std::string maps = absl::Substitute(
+        "7f0000000000-7f0000001000 r-xp 00000000 08:01 11 $0\n"
+        "7f0000001000-7f0000002000 r-xp 00000000 08:01 12 $1\n",
+        kLibSSLPath, kLibCryptoPath);
+    PX_CHECK_OK(WriteFileFromString(system::ProcPidPath(pid, "maps"), maps));
+    LinkInRoot(pid, kLibSSLPath, host_libssl);
+    LinkInRoot(pid, kLibCryptoPath, host_libcrypto);
+  }
+
+  // A process running host_exe as /app/server.
+  void FakeExeProcess(int pid, const std::filesystem::path& host_exe) {
+    PX_CHECK_OK(fs::CreateDirectories(system::ProcPidPath(pid)));
+    PX_CHECK_OK(fs::CreateSymlink("/app/server", system::ProcPidPath(pid, "exe")));
+    LinkInRoot(pid, "/app/server", host_exe);
+  }
+
+  StatusOr<int> AttachOpenSSLUProbesOnDynamicLib(uint32_t pid) {
+    return uprobe_mgr_.AttachOpenSSLUProbesOnDynamicLib(pid);
+  }
+
+  int DeployGoUProbes(const absl::flat_hash_set<md::UPID>& upids) {
+    return uprobe_mgr_.DeployGoUProbes(upids);
+  }
+
+  const std::string original_proc_path_ = FLAGS_proc_path;
+  px::testing::TempDir temp_dir_;
+  FakeUProbeBCCWrapper bcc_;
+  UProbeManager uprobe_mgr_{&bcc_};
+  InMemoryBCCMap<ssl_source_t>* openssl_source_map_ = nullptr;
+  InMemoryBCCMap<struct go_tls_symaddrs_t>* go_tls_symaddrs_map_ = nullptr;
+};
