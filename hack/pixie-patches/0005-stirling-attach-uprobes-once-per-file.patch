+// A second process mapping the same libssl file gets its SSL source but no second set of probes.
+// A different file gets its own set.
+TEST_F(UProbeManagerTest, AttachesOpenSSLProbesOncePerFile) {
+  const std::filesystem::path libssl = HostFile("libssl.so.3");
+  const std::filesystem::path libcrypto = HostFile("libcrypto.so.3");
+  FakeOpenSSLProcess(kPID1, libssl, libcrypto);
+  FakeOpenSSLProcess(kPID2, libssl, libcrypto);
+
+  ASSERT_OK_AND_EQ(AttachOpenSSLUProbesOnDynamicLib(kPID1), kNumOpenSSLProbes);
+  EXPECT_THAT(bcc_.attached, SizeIs(kNumOpenSSLProbes));
+
+  ASSERT_OK_AND_EQ(AttachOpenSSLUProbesOnDynamicLib(kPID2), 0);
+  EXPECT_THAT(bcc_.attached, SizeIs(kNumOpenSSLProbes));
+
+  EXPECT_THAT(openssl_source_map_->entries,
+              UnorderedElementsAre(Pair(kPID1, kLibSSL_3_Source), Pair(kPID2, kLibSSL_3_Source)));
+
+  // Another container's copy of the library is another file.
+  FakeOpenSSLProcess(kPID3, HostFile("other/libssl.so.3"), HostFile("other/libcrypto.so.3"));
+  ASSERT_OK_AND_EQ(AttachOpenSSLUProbesOnDynamicLib(kPID3), kNumOpenSSLProbes);
+  EXPECT_THAT(bcc_.attached, SizeIs(2 * kNumOpenSSLProbes));
+}
