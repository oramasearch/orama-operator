+// When one probe fails to attach, the ones attached before it are detached, and the file is not
+// marked as probed, so the next process mapping it tries again.
+TEST_F(UProbeManagerTest, RollsBackPartlyAttachedOpenSSLProbes) {
+  const std::filesystem::path libssl = HostFile("libssl.so.3");
+  const std::filesystem::path libcrypto = HostFile("libcrypto.so.3");
+  FakeOpenSSLProcess(kPID1, libssl, libcrypto);
+  FakeOpenSSLProcess(kPID2, libssl, libcrypto);
+
+  // SSL_new is the last of the OpenSSL probes.
+  bcc_.fail_symbol = "SSL_new";
+  EXPECT_NOT_OK(AttachOpenSSLUProbesOnDynamicLib(kPID1));
+  EXPECT_THAT(bcc_.attached, IsEmpty());
+
+  bcc_.fail_symbol.clear();
+  ASSERT_OK_AND_EQ(AttachOpenSSLUProbesOnDynamicLib(kPID2), kNumOpenSSLProbes);
+  EXPECT_THAT(bcc_.attached, SizeIs(kNumOpenSSLProbes));
+}
