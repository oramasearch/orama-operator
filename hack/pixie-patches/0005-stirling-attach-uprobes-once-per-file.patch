+// Records uprobe attaches and detaches instead of loading them into the kernel.
+// AttachUProbe fails for fail_symbol, to exercise the rollback of a partly attached set.
+class FakeUProbeBCCWrapper : public bpf_tools::ReplayingBCCWrapperImpl {
+ public:
+  Status AttachUProbe(const UProbeSpec& spec) override {
+    if (!fail_symbol.empty() && spec.symbol == fail_symbol) {
+      return error::Internal("Injected failure attaching $0.", spec.symbol);
+    }
+    attached.push_back(spec);
+    return Status::OK();
+  }
+
+  Status DetachUProbe(const UProbeSpec& spec) override {
+    auto iter = std::find(attached.begin(), attached.end(), spec);
+    if (iter != attached.end()) {
+      attached.erase(iter);
+    }
+    return Status::OK();
+  }
+
+  std::string fail_symbol;
+  std::vector<UProbeSpec> attached;
+};
+
+// Keeps a BPF map's entries in memory, so the test can read what UProbeManager wrote per PID.
+template <typename V>
+class InMemoryBCCMap : public bpf_tools::WrappedBCCMap<uint32_t, V, /*user space managed*/ true> {
+ public:
+  size_t capacity() const override { return 1024; }
+
+  StatusOr<V> GetValue(const uint32_t& key) const override {
+    auto iter = entries.find(key);
+    if (iter == entries.end()) {
+      return error::NotFound("No entry for key $0.", key);
+    }
+    return iter->second;
+  }
+
+  Status SetValue(const uint32_t& key, const V& value) override {
+    entries[key] = value;
+    return Status::OK();
+  }
+
+  Status RemoveValue(const uint32_t& key) override {
+    entries.erase(key);
+    return Status::OK();
+  }
+
+  std::vector<std::pair<uint32_t, V>> GetTableOffline(const bool) override {
+    return {entries.begin(), entries.end()};
+  }
+
+  absl::flat_hash_map<uint32_t, V> entries;
+};
