+StatusOr<int> UProbeManager::AttachUProbeTmplOncePerFile(
+    const ArrayView<UProbeTmpl>& probe_tmpls, const std::string& binary,
+    obj_tools::ElfReader* elf_reader, absl::flat_hash_set<FileIdentity>* probed_files,
+    std::string_view probes_name) {
+  StatusOr<FileIdentity> file_or = IdentifyFile(binary);
+  if (!file_or.ok()) {
+    // The process exited and took the file's path with it.
+    VLOG(1) << absl::Substitute("Skipping $0 uprobes on $1: $2", probes_name, binary,
+                                file_or.msg());
+    return 0;
+  }
+  const FileIdentity file = file_or.ConsumeValueOrDie();
+  if (!probed_files->insert(file).second) {
+    return 0;
+  }
+
+  StatusOr<int> count_or = AttachUProbeTmpl(probe_tmpls, binary, elf_reader);
+  if (!count_or.ok()) {
+    // Nothing stayed attached, so a later process running this file can try again.
+    probed_files->erase(file);
+    return count_or;
+  }
+  LOG(INFO) << absl::Substitute("Attached $0 $1 uprobes to $2", count_or.ValueOrDie(), probes_name,
+                                binary);
+  return count_or;
 }
 
