+
+// scriptBundleURLs is where the API server reads PxL scripts from: SCRIPT_BUNDLE_URLS (a JSON list,
+// the same value the UI is given through pl-script-bundles-config) when it is set, so a self-hosted,
+// air-gapped Cloud reads its own bundle; otherwise Pixie's public bundles, as before.
+func scriptBundleURLs() []string {
+	if raw := os.Getenv("SCRIPT_BUNDLE_URLS"); raw != "" {
+		var urls []string
+		if err := json.Unmarshal([]byte(raw), &urls); err == nil && len(urls) > 0 {
+			return urls
+		}
+		log.WithField("SCRIPT_BUNDLE_URLS", raw).Error("SCRIPT_BUNDLE_URLS is not a JSON list of URLs; using the default bundles")
+	}
+	return []string{defaultBundleFile, ossBundleFile}
 }
